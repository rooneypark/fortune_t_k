; Engine configuration file.
; 운빨삼국 (grok_fortune3k) — Godot 4.7. 세로 모바일, 픽셀아트, 논리 해상도 1024x1792 (GDD v5 / 화면 설계서 §1).

config_version=5

[application]

config/name="운빨삼국"
config/description="천명 슬롯 삼국지 — 슬롯으로 장수를 영입해 성을 지키는 오토 배틀"
config/version="0.1.0"
run/main_scene="res://src/app/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.141, 0.090, 0.051, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

Sfx="*res://src/autoload/sfx.gd"
Game="*res://src/autoload/game.gd"

[display]

window/size/viewport_width=1024
window/size/viewport_height=1792
window/size/window_width_override=256
window/size/window_height_override=448
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

common/snap_controls_to_pixels=true
theme/default_font_antialiasing=0
theme/default_font_hinting=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.0823529, 0.137255, 0.203922, 1)
